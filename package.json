{
  "name": "novail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --watch app/server.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env app/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test app/*.test.mjs packages/domain/*.test.mjs packages/execution/*.test.mjs src/*.test.mjs"
  },
  "dependencies": {
    "@slop-lab/part": "0.1.0",
    "@slop-lab/part-plugins": "0.1.0",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@hono/node-server": "^1.19.0",
    "docx": "9.7.1",
    "hono": "^4.9.0",
    "ky": "^1.10.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jszip": "^3.10.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
