# Copy this file to .env.router4u. Never commit the project key.
# Create the key in Router4U after connecting your personal account and enabling one route.
OPENAI_BASE_URL=http://127.0.0.1:9470/v1
OPENAI_API_KEY=
# Select an exact ID shown by Router4U after model discovery; no default is safe.
OPENAI_MODEL=

# Keep this verification/dev server separate from any existing NOVAIL state.
PORT=3001
NOVAIL_DATA_FILE=.data/router4u-state.json
