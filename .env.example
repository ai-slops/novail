# PostgreSQL is recommended. Without DATABASE_URL the app uses local file storage.
DATABASE_URL=postgresql://novail:novail-local@localhost:5432/novail
PORT=3000
# Leave empty for explicitly labeled, deterministic sample mode. This may be a provider API key or proxy key.
OPENAI_API_KEY=
# Any OpenAI-compatible /v1 endpoint can be used. Example Router4U: http://127.0.0.1:9470/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
