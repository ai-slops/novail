# PostgreSQL is recommended. Without DATABASE_URL the app uses local file storage.
DATABASE_URL=postgresql://novail:novail-local@localhost:5432/novail
PORT=3000
# Leave empty for explicitly labeled, deterministic sample mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
